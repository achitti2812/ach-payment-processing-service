NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://ach:ach_dev_password@localhost:5432/ach_payments?schema=public
REDIS_URL=redis://localhost:6379
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
